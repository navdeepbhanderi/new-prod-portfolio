# Canonical origin. Leave unset to use the custom domain (navdeepbhanderi.dev).
# Set it to the deployment's own URL when there is no custom domain attached,
# e.g. https://your-project.vercel.app - otherwise canonicals, the sitemap, OG
# images and the email links all point at a domain this deployment isn't on.
# Always https for public origins (http:// values are auto-upgraded).
NEXT_PUBLIC_SITE_URL=

# Google Search Console meta-tag verification token (the content="..." value).
# Optional - DNS-based verification doesn't need it.
GOOGLE_SITE_VERIFICATION=

# AI chat widget - Google Gemini
# Get a free key at https://aistudio.google.com/apikey
# Without a key the widget falls back to the built-in static knowledge base.
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash
GEMINI_MODEL=

# Contact form delivery - preferred: Resend (https://resend.com, free tier).
# Verify the domain in Resend (it gives you SPF + DKIM DNS records to add),
# then set both of these. Sending from the domain is what keeps mail out of
# spam. MAIL_FROM must use the verified domain.
RESEND_API_KEY=
MAIL_FROM="Navdeep Bhanderi <hello@navdeepbhanderi.dev>"

# Fallback: Gmail SMTP (App Password, not the account password), used when the
# Resend vars above are unset.
# Create one at https://myaccount.google.com/apppasswords (needs 2FA enabled)
# If notifications land in spam, add a Gmail filter for mail from GMAIL_USER
# with "Never send it to Spam" - self-sent SMTP mail with a visitor Reply-To
# often trips the filter the first few times.
GMAIL_USER=work.navdeepbhanderi@gmail.com
GMAIL_APP_PASSWORD=
# Where inquiry notifications land (defaults to the profile email)
CONTACT_TO=navdeepbhanderi1@gmail.com
